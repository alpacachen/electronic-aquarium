{
  "name": "electronic-aquarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:colors && tsc --noEmit && vite build",
    "check:colors": "node scripts/check-colors.mjs",
    "check": "pnpm test && pnpm build",
    "test": "vitest run --config vite.config.ts --reporter=default --reporter=verbose",
    "test:watch": "vitest --config vite.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "4.3.3",
    "clsx": "2.1.1",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.26.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.11",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "three": "^0.185.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1",
    "shadcn": "4.16.2",
